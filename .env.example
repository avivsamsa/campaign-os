NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
META_SYSTEM_USER_TOKEN=

# Secret for signing client-portal AND admin session cookies (any long random string)
PORTAL_SESSION_SECRET=

# Admin gate — password to access /adminadmin and all admin APIs (choose a strong one)
ADMIN_PASSWORD=

# Real-time leads via Make (shared secret; sent as ?key= from the Make HTTP module)
MAKE_WEBHOOK_SECRET=

# Meta leadgen webhook (only if using the native Meta webhook instead of Make)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Optional: protects /api/cron/sync (Vercel Cron sends it automatically as a Bearer)
CRON_SECRET=
