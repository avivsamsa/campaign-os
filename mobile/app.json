{
  "expo": {
    "name": "Campaign OS",
    "slug": "campaign-os",
    "version": "1.0.0",
    "scheme": "campaignos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0C0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "il.co.avivsamsa.campaignos",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Campaign OS"
      }
    },
    "android": {
      "package": "il.co.avivsamsa.campaignos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A8325A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
