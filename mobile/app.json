{
  "expo": {
    "name": "Campaign OS",
    "slug": "campaign-os",
    "version": "1.0.0",
    "scheme": "campaignos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0C0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "il.co.avivsamsa.campaignos",
      "buildNumber": "1",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Campaign OS"
      }
    },
    "android": {
      "package": "il.co.avivsamsa.campaignos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A8325A"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf3bc97f-0832-4a8d-be49-7883e1b0c357"
      }
    },
    "owner": "avivv15"
  }
}
